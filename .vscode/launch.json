{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run CodeChronicle Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extension",
                "--user-data-dir=${workspaceFolder}/.vscode/.cc-dev-user-data",
                "--extensions-dir=${workspaceFolder}/.vscode/.cc-dev-extensions"
            ],
            "outFiles": [
                "${workspaceFolder}/extension/dist/**/*.js"
            ],
            "preLaunchTask": "npm: dev - extension"
        },
        {
            "name": "Run CodeChronicle (No Build)",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/extension",
                "--user-data-dir=${workspaceFolder}/.vscode/.cc-dev-user-data",
                "--extensions-dir=${workspaceFolder}/.vscode/.cc-dev-extensions"
            ],
            "outFiles": [
                "${workspaceFolder}/extension/dist/**/*.js"
            ]
        }
    ]
}